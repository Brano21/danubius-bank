#!/usr/bin/env bash
# Cloud-init for the Danubius Bank CTF host. Installs prereqs, clones the repo,
# then hands off to deploy/manual-setup.sh which brings up the WHOLE stack (the
# vulnerable app on :8080 + CTFd on :80 from the single docker-compose.yml) and
# seeds CTFd. Same script a human runs manually - one code path, no drift.
set -euxo pipefail
exec > >(tee -a /var/log/danubius-deploy.log) 2>&1
echo "== danubius deploy start: $(date -u) =="

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y git curl ca-certificates openssl python3 python3-pip jq

# --- Docker (+ compose plugin) ---
curl -fsSL https://get.docker.com | sh
usermod -aG docker ubuntu || true
systemctl enable --now docker
pip3 install --quiet requests || apt-get install -y python3-requests || true

# --- Clone the repo ---
APP_DIR=/opt/danubius-bank
git clone --branch "${repo_ref}" "${repo_url}" "$APP_DIR"
cd "$APP_DIR"

# --- Bring up + seed everything via the shared bootstrap script ---
ADMIN_USER="${ctfd_admin_user}" \
ADMIN_PASSWORD="${ctfd_admin_password}" \
WEEK="${week}" \
CTF_NAME="${ctf_name}" \
MAX_TEAM_SIZE="${max_team_size}" \
bash deploy/manual-setup.sh

echo "== danubius deploy done: $(date -u) =="
