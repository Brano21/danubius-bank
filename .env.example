# ---- Runtime ----
WEEK=1
SECRET_KEY=change-me-in-real-runs

# ---- Database ----
DB_NAME=danubius
DB_USER=danubius
DB_PASSWORD=danubius

# ---- Flags ----
# One env var per task. Name = FLAG_ + task id ('-' -> '_'), upper-case.
# CTFd wraps the real value as RPC{...}; the app just returns whatever is set.
# Only the ACTIVE week's flags need to be present; later weeks are listed for
# reference and get wired into the web container as you raise WEEK.

# Week 1
FLAG_W1_01=RPC{demo_w1_01_sql_login_bypass}
FLAG_W1_02=RPC{4917_4500_1200_6710}
FLAG_W1_03=RPC{demo_w1_03_stored_xss_admin_cookie}
FLAG_W1_04=RPC{demo_w1_04_reflected_xss}
FLAG_W1_05=RPC{demo_w1_05_os_command_injection}

# Week 2
FLAG_W2_01=RPC{demo_w2_01_bola}
FLAG_W2_02=RPC{demo_w2_02_bfla}
FLAG_W2_03=RPC{demo_w2_03_mass_assignment}
FLAG_W2_04=RPC{demo_w2_04_fraud_bypass}
FLAG_W2_05=RPC{demo_w2_05_error_leak}

# Week 3
FLAG_W3_01=RPC{demo_w3_01_direct_prompt_injection}
FLAG_W3_02=RPC{demo_w3_02_secrecy_bypass}
FLAG_W3_03=RPC{demo_w3_03_indirect_injection}
FLAG_W3_04=RPC{demo_w3_04_excessive_agency}

# Week 4  (W4-05 is human-graded, no flag)
FLAG_W4_01=RPC{demo_w4_01_entry_point}
FLAG_W4_02=RPC{demo_w4_02_leak_scope}
FLAG_W4_03=RPC{demo_w4_03_lateral_movement}
FLAG_W4_04=RPC{demo_w4_04_static_analysis}

# ---- Week 3 LLM (Ollama) ----
OLLAMA_MODEL=llama3.2:3b

# ---- Access gate + operator dashboard ----
# The gate is the only published service; players log in here (accounts in
# gate/players.json) and the operator dashboard lives at /_gate/admin.
GATE_SECRET=change-me-gate-secret
GATE_ADMIN_USER=admin
GATE_ADMIN_PASSWORD=change-me-admin
# Session: valid for 7 days of inactivity, token refreshed every 12h (gate/app.py).
# Passwords in gate/players.json may be plaintext (dev) or werkzeug hashes
# (pbkdf2:/scrypt:). Behind HTTPS set GATE_COOKIE_SECURE=1.
GATE_COOKIE_SECURE=0
