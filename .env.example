# Copy to .env and change EVERY secret before any shared run.  `.env` is git-ignored.
# On a server, deploy/manual-setup.sh generates this file for you with random values.

# ---- Runtime ----
WEEK=4                     # 1..4; 4 = full lab (W1-W4, incl. the Week-3 LLM)
SECRET_KEY=change-me-flask-secret   # REQUIRED (bank app session signing)

# ---- Database (internal; defaults are fine for a lab) ----
DB_NAME=danubius
DB_USER=danubius
DB_PASSWORD=danubius

# ==========================================================================
# ONE admin, everywhere. This single account is:
#   - the CTFd admin (creates player accounts, runs the scoreboard), and
#   - the gate operator (monitoring dashboard at :8080/_gate/admin).
# Players are created by this admin in CTFd Admin -> Users; their CTFd
# credentials then also let them through the app gate (the gate validates
# against CTFd). Keep GATE_ADMIN_* equal to CTFD_ADMIN_* for a single login.
# ==========================================================================
CTFD_ADMIN_USER=ctfadmin
CTFD_ADMIN_PASSWORD=change-me-strong-admin-password   # REQUIRED (no default)
GATE_ADMIN_USER=ctfadmin
GATE_ADMIN_PASSWORD=change-me-strong-admin-password   # keep == CTFD_ADMIN_PASSWORD

# ---- CTFd scoreboard ----
CTF_NAME=Danubius Bank CTF
MAX_TEAM_SIZE=3
CTFD_SECRET_KEY=change-me-ctfd-secret    # REQUIRED (stable across CTFd workers)
CTFD_DB_ROOT_PASSWORD=change-me-ctfd-db-root

# ---- Access gate ----
GATE_SECRET=change-me-gate-secret        # REQUIRED (gate session signing)
# CTFD_URL: where the gate reaches CTFd to validate logins (internal compose DNS).
CTFD_URL=http://ctfd:8000
# Behind HTTPS (a real ALB/reverse proxy), set this to 1.
GATE_COOKIE_SECURE=0

# ---- Week 3 LLM (Ollama) ----
OLLAMA_MODEL=llama3.2:3b

# ---- Week 4 operator evidence download (/evidence?key=...) ----
# Defaults to GATE_ADMIN_PASSWORD. Never share with players (embeds every W4 flag).
WEEK4_KEY=change-me-strong-admin-password

# ---- Flags ----
# One env var per task (FLAG_ + task id, '-' -> '_', upper-case). CTFd is seeded
# with THESE values so the scoreboard matches the app. On a server the setup
# script generates random flags; the demo values below are for LOCAL runs only.
FLAG_W1_01=RPC{demo_w1_01_sql_login_bypass}
FLAG_W1_02=RPC{4917_4500_1200_6710}
FLAG_W1_03=RPC{demo_w1_03_stored_xss_admin_cookie}
FLAG_W1_04=RPC{demo_w1_04_reflected_xss}
FLAG_W1_05=RPC{demo_w1_05_os_command_injection}
FLAG_W2_01=RPC{demo_w2_01_bola}
FLAG_W2_02=RPC{demo_w2_02_bfla}
FLAG_W2_03=RPC{demo_w2_03_mass_assignment}
FLAG_W2_04=RPC{demo_w2_04_fraud_bypass}
FLAG_W2_05=RPC{demo_w2_05_error_leak}
FLAG_W3_01=RPC{demo_w3_01_direct_prompt_injection}
FLAG_W3_02=RPC{demo_w3_02_secrecy_bypass}
FLAG_W3_03=RPC{demo_w3_03_indirect_injection}
FLAG_W3_04=RPC{demo_w3_04_excessive_agency}
FLAG_W4_01=RPC{demo_w4_01_entry_point}
FLAG_W4_02=RPC{demo_w4_02_leak_scope}
FLAG_W4_03=RPC{demo_w4_03_lateral_movement}
FLAG_W4_04=RPC{demo_w4_04_static_analysis}
FLAG_W4_05=RPC{demo_w4_05_c2_reconstruction}
